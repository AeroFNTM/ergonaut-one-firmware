#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV 1
#define MOUSE 2
#define MEDIA 3
#define NUM 4
#define SYM 5
#define FUN 6
#define ADJ 7

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <130>;
        };

        td_enter: td_enter {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_ENTER";
            #binding-cells = <0>;
            bindings = <&kp APOS>, <&kp RETURN>;
        };

        td_tab: td_tab {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_TAB";
            #binding-cells = <0>;
            bindings = <&kp A>, <&kp TAB>, <&kp CAPS>;
        };

        td_esc: td_esc {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_ESC";
            #binding-cells = <0>;
            bindings = <&kp Q>, <&kp ESCAPE>;
        };

        ht_mouse: ht_mouse {
            compatible = "zmk,behavior-tap-dance";
            label = "HT_MOUSE";
            #binding-cells = <0>;
            bindings = <&mo 2>, <&tog 2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "MAIN";
            bindings = <
&td_esc  &kp W       &kp E            &kp R        &kp T        &kp Y            &kp U        &kp I        &kp O       &kp P
&td_tab  &hm LALT S  &hm LS(LCTRL) D  &hm LSHFT F  &hm LCTRL G  &hm RIGHT_GUI H  &hm LSHFT J  &hm LCTRL K  &hm LALT L  &td_enter
&kp Z    &kp X       &kp C            &kp V        &kp B        &kp COMMA        &kp N        &kp M        &kp DOT     &kp FSLH
                                      &mo 6        &ht_mouse    &lt 1 BACKSPACE  &lt 3 SPACE  &tog 4       &tog 5
            >;
        };

        nav_layer {
            display-name = "LEFT";
            bindings = <
&kp LS(EXCLAMATION)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(N5)            &kp RS(NUMBER_6)   &kp RS(N7)  &kp RS(N8)      &kp RS(N9)  &kp RS(N0)
&kp TILDE            &none             &none             &none             &kp C_BRI_UP          &kp C_VOLUME_UP    &kp HOME    &kp UP_ARROW    &kp END     &kp PAGE_UP
&none                &none             &none             &none             &kp C_BRIGHTNESS_DEC  &kp C_VOLUME_DOWN  &kp LEFT    &kp DOWN_ARROW  &kp RIGHT   &kp PAGE_DOWN
                                                         &none             &none                 &none              &trans      &kp BSPC        &kp DEL
            >;
        };

        mouse_layer {
            display-name = "MOUSE";
            bindings = <
&none     &none     &none      &none      &none  &kp C_AC_BACK   &kp C_AC_REFRESH  &kp C_AC_FORWARD  &kp C_AC_HOME    &kp PRINTSCREEN
&kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none  &msc SCRL_UP    &mkp RCLK         &mmv MOVE_UP      &mkp LCLK        &msc SCRL_LEFT
&none     &none     &none      &none      &none  &msc SCRL_DOWN  &mmv MOVE_LEFT    &mmv MOVE_DOWN    &mmv MOVE_RIGHT  &msc SCRL_RIGHT
                               &mo 6      &none  &none           &trans            &none             &none
            >;
        };

        num_row {
            display-name = "RIGHT";
            bindings = <
&kp NUMBER_1   &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5      &kp NUMBER_6  &kp N7     &kp N8            &kp N9             &kp N0
&kp BACKSLASH  &kp APOS      &kp SEMI      &kp COMMA     &kp PERIOD  &kp MINUS     &kp EQUAL  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &none
&none          &none         &none         &none         &none       &none         &none      &none             &none              &none
                                           &none         &none       &mo 6         &trans     &kp C_PP          &kp K_MUTE
            >;
        };

        key_pad {
            display-name = "NUM";
            bindings = <
&none  &none  &none  &none  &none  &kp KP_PLUS      &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_MINUS
&none  &none  &none  &none  &none  &kp KP_MULTIPLY  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_DIVIDE
&none  &none  &none  &none  &none  &kp KP_N0        &kp KP_N1        &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_DOT
                     &none  &none  &kp BACKSPACE    &kp KP_EQUAL     &tog 1           &kp KP_NUMLOCK
            >;
        };

        fun_layer {
            display-name = "FUN";
            bindings = <
&kp F10  &kp F1  &kp F2  &kp F3     &kp PSCRN        &none    &none      &none      &none     &none
&kp F11  &kp F4  &kp F5  &kp F6     &kp SLCK         &none    &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI
&kp F12  &kp F7  &kp F8  &kp F9     &kp PAUSE_BREAK  &none    &none      &none      &none     &none
                         &kp K_APP  &kp SPACE        &kp TAB  &mo 6      &none      &tog 5
            >;
        };

        adj_layer {
            display-name = "BT_LAYER";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_SEL 4    &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0
&bt BT_CLR    &bt BT_PRV    &bt BT_NXT    &sys_reset    &bootloader     &bootloader     &sys_reset    &bt BT_NXT    &bt BT_PRV    &bt BT_CLR
&out OUT_TOG  &out OUT_BLE  &out OUT_USB  &none         &studio_unlock  &studio_unlock  &none         &out OUT_USB  &out OUT_BLE  &out OUT_TOG
                                          &none         &none           &none           &none         &none         &none
            >;
        };
    };
};

Ok
